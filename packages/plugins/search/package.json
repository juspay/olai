{
  "name": "olai-plugin-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./browser": "./src/browser.tsx",
    "./testids": "./src/testids.ts",
    "./all.css": "./src/browser/all.css",
    "./surface": "./src/surface.ts",
    "./tools": "./src/tools.ts",
    "./box": "./src/contracts/box.ts",
    "./reading": "./src/contracts/reading.ts",
    "./ui/*": "./src/contracts/ui/*",
    "./ui/Shortlist.tsx": "./src/contracts/ui/Shortlist.tsx",
    "./ui/Count.tsx": "./src/contracts/ui/Count.tsx",
    "./ui/PlaceLine.tsx": "./src/contracts/ui/PlaceLine.tsx",
    "./ui/Result.tsx": "./src/contracts/ui/Result.tsx",
    "./ui/count.ts": "./src/contracts/ui/count.ts",
    "./ui/place.ts": "./src/contracts/ui/place.ts",
    "./ui/props.ts": "./src/contracts/ui/props.ts",
    "./ui/row.ts": "./src/contracts/ui/row.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@olai/format": "workspace:*",
    "@olai/ops": "workspace:*",
    "@olai/plugin-api": "workspace:*",
    "@olai/web": "workspace:*",
    "effect": "4.1.4",
    "solid-js": "^1.9.0",
    "olai-plugin-navigation": "workspace:*",
    "olai-plugin-ui-renderer": "workspace:*",
    "@olai/ui-primitives": "workspace:*",
    "@olai/store": "workspace:*",
    "@olai/surface": "workspace:*",
    "@olai/markdown-ui": "workspace:*",
    "olai-plugin-outlines": "workspace:*",
    "olai-plugin-vault": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "@olai/store": "workspace:*",
    "@types/node": "^22.0.0",
    "olai-plugin-layout": "workspace:*",
    "olai-plugin-outline-olai": "workspace:*",
    "@olai/tests": "workspace:*"
  },
  "olai": {
    "contracts": [
      "./testids",
      "./surface",
      "./reading",
      "./box",
      "./ui/Count.tsx",
      "./ui/Result.tsx",
      "./ui/Shortlist.tsx",
      "./ui/count.ts",
      "./ui/place.ts",
      "./ui/PlaceLine.tsx",
      "./ui/props.ts",
      "./ui/row.ts"
    ]
  }
