    "./making": "./src/file/making.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@olai/plugin-api": "workspace:*",
    "effect": "4.0.0-rc.112",
    "solid-js": "^1.9.0",
    "olai-plugin-ui-renderer": "workspace:*",
    "@olai/web": "workspace:*",
    "@olai/format": "workspace:*",
    "@olai/surface": "workspace:*",
    "olai-plugin-navigation": "workspace:*",
    "olai-plugin-sidebar": "workspace:*",
    "olai-plugin-layout": "workspace:*",
    "@solid-primitives/keyed": "^1.5.2",
    "@olai/ops": "workspace:*",
    "@olai/store": "workspace:*",
    "@olai/edit-intents": "workspace:*",
