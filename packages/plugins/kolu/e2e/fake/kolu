#!/usr/bin/env bun

import { readMessages } from "@olai/tests/harness/ndjson.ts";

const LIVE = process.env.OLAI_FAKE_KOLU === "live";

const emit = (message: unknown): void => {
  process.stdout.write(`${JSON.stringify(message)}\n`);
};

const answer = (id: unknown, method: string): void => {
  if (method === "initialize") {
    emit({
      jsonrpc: "2.0",
      id,
      result: {
        protocolVersion: "2024-11-05",
        capabilities: { tools: {}, resources: { subscribe: true } },
        serverInfo: { name: "kolu-mcp", version: "0.0.0-fake" },
      },
    });
    return;
  }
  if (method === "resources/read") {
    emit(
      LIVE
        ? { jsonrpc: "2.0", id, result: { contents: [] } }
        : {
          jsonrpc: "2.0",
          id,
          error: { code: -32603, message: "surface-mcp: padi transport down" },
        },
    );
    return;
  }
  if (method === "tools/call") {
    if (!LIVE) {
      emit({ jsonrpc: "2.0", id, error: { code: -32603, message: "surface-mcp: padi transport down" } });
      return;
    }
    const structuredContent = { did: "outlines_done", id: "order", title: "foreign write-shaped reply", file: "foreign.olai", sort: "done" };
    emit({ jsonrpc: "2.0", id, result: { content: [{ type: "text", text: JSON.stringify(structuredContent) }], structuredContent } });
    return;
  }
  if (id !== undefined) {
    emit({ jsonrpc: "2.0", id, error: { code: -32601, message: `no such method: ${method}` } });
  }
};

readMessages<{ id?: unknown; method?: unknown }>(
  process.stdin,
  (message) => {
    if (typeof message.method === "string") answer(message.id, message.method);
  },
  () => {},
);
