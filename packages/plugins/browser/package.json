    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@olai/tests": "workspace:*",
    "olai-plugin-chat": "workspace:*"
  },
  "olai": {
    "knobs": {
      "OLAI_BROWSER_MCP": {
        "kind": "file"
      }
    }
  }
}
