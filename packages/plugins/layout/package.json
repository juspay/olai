{
  "name": "olai-plugin-layout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.tsx",
    "./all.css": "./src/all.css",
    "./contract": "./src/index.ts",
    "./*": "./src/*",
    "./preferences": "./src/layout/prefs.ts",
    "./media": "./src/layout/media.ts",
    "./chip": "./src/layout/chip.ts",
    "./entry": "./src/layout/entry.ts",
    "./tab": "./src/layout/tab.ts",
    "./sheet": "./src/layout/sheet.ts",
    "./geometry": "./src/pane/geometry.ts",
    "./slots": "./src/slots.ts",
    "./testids": "./src/testids.ts",
    "./bar-door": "./src/contracts/BarDoor.tsx",
    "./clearance": "./src/contracts/clearance.ts",
    "./thumb": "./src/contracts/Thumb.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@olai/plugin-api": "workspace:*",
    "effect": "4.1.4",
    "solid-js": "^1.9.0",
    "olai-plugin-ui-renderer": "workspace:*",
    "@olai/web": "workspace:*",
    "@olai/format": "workspace:*",
    "@olai/surface": "workspace:*",
    "olai-plugin-navigation": "workspace:*",
    "@olai/ui-primitives": "workspace:*"
  },
  "olai": {
    "contracts": [
      "./preferences",
      "./media",
      "./chip",
      "./entry",
      "./tab",
      "./sheet",
      "./geometry",
      "./slots",
      "./testids",
      "./bar-door",
      "./clearance",
      "./thumb"
    ]
  },
  "devDependencies": {
    "@olai/tests": "workspace:*"
  }
}
