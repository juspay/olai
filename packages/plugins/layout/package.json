{
  "name": "olai-plugin-layout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.tsx",
    "./all.css": "./src/all.css",
    "./contract": "./src/index.ts",
    "./*": "./src/*",
    "./preferences": "./src/layout/prefs.ts",
    "./media": "./src/layout/media.ts",
    "./chip": "./src/layout/chip.ts",
    "./entry": "./src/layout/entry.ts",
    "./sheet": "./src/layout/sheet.ts",
    "./geometry": "./src/pane/geometry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@olai/plugin-api": "workspace:*",
    "effect": "4.0.0-rc.112",
    "solid-js": "^1.9.0",
    "olai-plugin-ui-renderer": "workspace:*",
    "@olai/web": "workspace:*",
    "@olai/format": "workspace:*",
    "@olai/surface": "workspace:*",
    "olai-plugin-navigation": "workspace:*",
    "@olai/ui-primitives": "workspace:*"
  },
  "olai": {
    "contracts": [
      "./preferences",
      "./media",
      "./chip",
      "./entry",
      "./sheet",
      "./geometry"
    ]
  }
}
