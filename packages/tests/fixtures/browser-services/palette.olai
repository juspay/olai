{"id":"palette","ord":"a0","title":"Shared palette","custom":{"plugin":"palette"}}
{"id":"palette-server","parent":"palette","ord":"a0","title":"server.ts","desc":"import { definePlugin, Offers } from \"@olai/plugin-api\"\nimport { Effect } from \"effect\"\nexport default definePlugin({ name: \"palette\", needs: [Offers], apply: Effect.gen(function*() {\n  yield* (yield* Offers).browser([\"colours\"])\n}) })"}
{"id":"palette-browser","parent":"palette","ord":"a1","title":"browser.tsx","desc":"import { definePlugin, Offers } from \"@olai/plugin-api\"\nimport { Effect } from \"effect\"\nexport default definePlugin({ name: \"palette\", needs: [], apply: Effect.void })\nexport const components = {\n  colours: definePlugin({ name: \"ignored\", needs: [Offers], apply: Effect.gen(function*() {\n    yield* (yield* Offers).own(\"colours\", () => ({ coat: \"browser-palette-first\" }))\n  }) }),\n}"}
