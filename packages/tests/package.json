{
  "name": "@olai/tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./harness/*": "./support/*",
    "./agent/*": "./agent/*"
  },
  "scripts": {
    "test": "bun ./node_modules/@cucumber/cucumber/bin/cucumber.js --profile ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@olai/bundle": "workspace:*",
    "@olai/fonts": "workspace:*",
    "@olai/format": "workspace:*",
    "@olai/plugin-api": "workspace:*",
    "@olai/surface": "workspace:*",
    "@olai/web": "workspace:*",
    "@olai/markdown-ui": "workspace:*",
    "olai-plugin-chat": "workspace:*",
    "olai-plugin-kolu": "workspace:*",
    "olai-plugin-odu": "workspace:*",
    "olai-plugin-outlines": "workspace:*",
    "@olai/appearance": "workspace:*",
    "@olai/log": "workspace:*",
    "@olai/ui-primitives": "workspace:*",
    "olai-plugin-alerts": "workspace:*",
    "olai-plugin-markdown": "workspace:*",
    "olai-plugin-hypertext": "workspace:*",
    "olai-plugin-csv": "workspace:*",
    "olai-plugin-image": "workspace:*",
    "olai-plugin-pdf": "workspace:*",
    "olai-plugin-mail": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.1",
    "@olai/log": "workspace:*",
    "playwright": "1.61.1"
  }
}
