{
  // Per-package `tsc --noEmit` anchor. Shared options live in
  // ../../tsconfig.base.json; this member points tsc at the TypeScript this
  // package holds. `features/` is Gherkin and `cucumber.js` is plain JS read
  // by the runner, so neither is compiled. `allowJs` is for
  // `support/parallelism.js` — the count has to be JS because cucumber-js
  // reaches it through `cucumber.js`, with its own loader rather than the
  // suite's, and the TypeScript side re-exports it.
  //
  // `*.ts` is the package ROOT, and it is here because it was missing: the
  // unit tests beside this file and the three DRIVERS (`evidence.ts`,
  // `wire.ts`, `shot.ts`, `underload.ts`) are TypeScript that the `typecheck`
  // leg was not reading, so a rename inside one of them failed in a lane —
  // or in a screenshot nobody could take — rather than in a second here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "allowJs": true, "checkJs": false },
  "include": ["*.ts", "agent", "support", "step_definitions"]
}
