---
import { getCollection, render, type CollectionEntry } from "astro:content"

import Docs from "../../layouts/Docs.astro"
import { hrefOf, type Reading } from "../../markdown.ts"

// Every page but the index, which the overview draws as cards.
export async function getStaticPaths() {
  const pages = await getCollection("docs", (page) => page.id !== "index")
  return pages.map((page) => ({
    params: { slug: hrefOf(page.id).slice("/docs/".length, -1) },
    props: { page },
  }))
}

const { page } = Astro.props as { page: CollectionEntry<"docs"> }
const { Content, headings, remarkPluginFrontmatter } = await render(page)
// The main flow, as the docs pass measured it: how long it is, and which of
// the page's `##` headings it holds.
const reading: Reading = remarkPluginFrontmatter.reading
const h2 = headings.filter((heading) => heading.depth === 2)
const sections = reading.sections.flatMap((at) => h2[at] ?? [])
// About 220 words a minute: enough to tell a glance from a sit-down.
const minutes = Math.max(1, Math.round(reading.words / 220))
---

<Docs id={page.id}>
  <p class="meta" slot="head">
    {minutes} min read{reading.notes > 0 && ` · ${reading.notes} notes, one tap away`}
  </p>

  {
    sections.length > 1 && (
      <details class="contents">
        <summary>On this page</summary>
        <ol>
          {sections.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  <article class="prose">
    <Content />
  </article>
</Docs>
