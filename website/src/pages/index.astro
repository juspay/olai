<script is:inline>
  document.querySelectorAll(".hero .box:not(.done)").forEach((box) => {
    box.style.cursor = "pointer";
    box.title = "tick it off";
    box.addEventListener("click", () => {
      if (box.classList.contains("done")) return;
      box.classList.remove("doing");
      box.classList.add("done", "just-done");
      const row = box.closest(".row");
      const title = row && row.querySelector(".t");
      if (title) title.classList.add("strike");
    });
  });

  const install = document.getElementById("install");
  if (install) {
    install.addEventListener("click", async () => {
      const text = install.textContent.replace(/\s+/g, " ").trim();
      try {
        await navigator.clipboard.writeText(text);
        install.title = "copied";
      } catch {
        install.title = "select and copy";
      }
    });
  }

  document.querySelectorAll(".chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const name = chip.getAttribute("data-theme");
      if (!name) return;
      document.documentElement.setAttribute("data-theme", name);
      document.querySelectorAll(".chip").forEach((other) => {
        other.classList.toggle("on", other === chip);
      });
    });
  });
</script>
</Base>
