---
/**
 * Every page's frame: the head, the header and the footer.
 */
import "../styles/site.css"

interface Props {
  title: string
  description: string
  /** Which header link is the page the reader is on. */
  current?: "start" | "docs"
}

const { title, description, current } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site).href
const github = "https://github.com/juspay/olai"
const ogImage = new URL("/og.png", Astro.site).href
const ogAlt = "olai — a git-native outliner. A palm leaf in ink on sea-glass paper."
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="olai" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;1,400&family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,400;1,9..144,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="wordmark" href="/">olai</a>
        <nav class="site" aria-label="Site">
          <a href="/docs/start/" aria-current={current === "start" ? "page" : undefined}>Start</a>
          <a href="/docs/" aria-current={current === "docs" ? "page" : undefined}>Docs</a>
          <a href={github}>GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site">
      <div class="wrap">
        <a class="wordmark" href="/">olai</a>
        <span><a href={github}>github.com/juspay/olai</a></span>
        <span><a href="/docs/">docs</a></span>
        <span><a href="/docs/running/">how to run it</a></span>
        <span><a href="https://github.com/juspay/oss.olai/tree/main/projects/olai/roadmap">roadmap</a></span>
        <span><a href="https://github.com/cordiverse/cordis">cordis</a></span>
        <span><a href="https://arxiv.org/abs/2608.25512">the paper</a></span>
        <span><a href="https://kolu.dev">kolu.dev</a></span>
      </div>
    </footer>
  </body>
</html>
