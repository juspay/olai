/.worktrees
node_modules
/result
/result-*
/.direnv
# odu's per-run state and logs
/.ci

# The browser bundle, built by `just build-client` (and by the nix build, into
# its own sandbox). Generated, never committed.
/packages/web/dist

# Throwaway scripts used while working; never part of a commit.
/.probe

# Bound URL of this worktree's `just run` / `just serve`, and the optional
# OLAI_BIN wrapper from `just dev-bin`. Per-worktree on purpose — a shared
# /tmp/olai-dev is how two worktrees used to dial each other.
/.olai-dev

# Review notes handed to the implementing agent — read, acted on, never
# committed. The PR is the record; a stale critique in the tree is not.
/PR-REVIEW.md

/.claude/settings.local.json

# A tenant's own mark, as a TypeScript module: GENERATED from that tenant's
# npins pin by packages/plugin-kit/default.nix, and copied into place by
# `just install` (the nix build regenerates it in its sandbox).
/packages/plugins/olai-plugin-kolu/src/browser/mark.generated.ts
/packages/plugins/olai-plugin-odu/src/browser/mark.generated.ts
