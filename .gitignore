# Belt-and-braces: never commit personal outline data if someone
# accidentally drops a copy in the repo. Canonical data is outside:
# $OLAI_HOME, wherever you set it. Roadmap.rkt is NOT
# personal data -- it's the project's own roadmap and lives at repo root,
# tracked like any other file.
/private/
/Tasks.rkt
/Daily.rkt

# Racket
compiled/
*.zo
*.dep

# Nix
/result
/result-*
.direnv/

# odu run state (socket, per-SHA logs, run records)
.ci/

# Local Racket user home for nix/dev
.plt-user/

# npm only ever runs here to regenerate acp/package-lock.json; the tree it
# leaves behind is nix's business, not the repo's.
/acp/node_modules/

# The e2e harness's deps are a derivation (e2e/default.nix); `just e2e`
# symlinks them here so ESM resolution can find them.
/e2e/node_modules

/.direnv

# Agent scratch worktrees
/.claude/

/.worktrees
