/.worktrees
node_modules
/result
/result-*
/.direnv
# odu's per-run state and logs
/.ci

# The browser bundle, built by `just build-client` (and by the nix build, into
# its own sandbox). Generated, never committed.
/packages/web/dist

# Throwaway scripts used while working; never part of a commit.
/.probe

# Review notes handed to the implementing agent — read, acted on, never
# committed. The PR is the record; a stale critique in the tree is not.
/PR-REVIEW.md

# Debate working folders — turn files are working material, never committed.
# A finished debate files its conclusion (the folder's README.md) under
# docs/, per .apm/skills/lowy-electricity/SKILL.md.
/debates
