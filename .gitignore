/.worktrees
node_modules
/result
/result-*
/.direnv
# odu's per-run state and logs
/.ci

# The browser bundle, built by `just build-client` (and by the nix build, into
# its own sandbox). Generated, never committed.
/packages/web/dist

# Throwaway scripts used while working; never part of a commit.
/.probe

# Bound URL of this worktree's `just run` / `just serve`, and the optional
# OLAI_BIN wrapper from `just dev-bin`. Per-worktree on purpose — a shared
# /tmp/olai-dev is how two worktrees used to dial each other.
/.olai-dev

# Screenshots taken to show a reviewer that a change looks right. They are
# evidence for a pull request, not part of the tree — the features are what
# holds the behaviour, and a PNG in git is a claim nobody can re-run.
/evidence

# Review notes handed to the implementing agent — read, acted on, never
# committed. The PR is the record; a stale critique in the tree is not.
/PR-REVIEW.md

# Debate working folders — turn files are working material, never committed.
# A finished debate files its conclusion (the folder's README.md) under
# docs/, per .apm/skills/lowy-electricity/SKILL.md.
/debates
docs/orchestrator/lanes.olai
/.claude/settings.local.json
docs/briefs/
