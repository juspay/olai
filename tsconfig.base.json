{
  // The one ambient declaration this repo owns — see the file itself. It rides
  // `files` rather than each package's `include`, because a per-package
  // `include` overrides the base's but leaves `files` inherited, so one entry
  // here reaches every member's `tsc --noEmit`.
  "files": ["types/bun-process-signals.d.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Bun imports a `.json` natively; without this tsc alone refuses to. The
    // one such import today is @olai/fonts's face table, which is JSON because
    // that package's own default.nix reads the same file.
    "resolveJsonModule": true,
    "types": ["bun"]
  }
}
