{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Bun imports a `.json` natively; without this tsc alone refuses to. The
    // one such import today is @olai/fonts's face table, which is JSON because
    // that package's own default.nix reads the same file.
    "resolveJsonModule": true,
    "types": ["bun"]
  }
}
